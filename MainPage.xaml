<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Nom" FontSize="16"/>
            <Entry Text="{Binding Nom, Mode=TwoWay}" Placeholder="Votre nom" FontSize="16"/>
            <Label Text="Date de naissance" FontSize="16"/>
            <DatePicker Date="{Binding DateNaissance}" FontSize="16"/>
            <Button Text="Calculer" Command="{Binding CalculerCommand}"/>
            <Button Text="Effacer" Command="{Binding EffacerCommand}" BackgroundColor="Red" TextColor="White"/>
            <Label Text="{Binding Resultat}" FontSize="20"
                   IsVisible="{Binding ResultatVisible}" HorizontalOptions="Center"/>
            <Label Text="{Binding StatusAge}" FontSize="16" HorizontalOptions="Center"/>
            <Label Text="{Binding JourAvantAnniversaire}" FontSize="16" HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
